{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.16.0/.schema/devbox.schema.json",
  "packages": {
    "go": "1.26.5",
    "kubebuilder": "4.15.0",
    "kubectl": "latest",
    "kind": "latest",
    "jq": "latest",
    "gnumake": "latest",
    "cargo": "latest",
    "rustc": "latest",
    "pkg-config": "latest",
    "openssl": {
      "version": "latest",
      "outputs": ["out", "dev"]
    },
    "quint": "0.32.0"
  },
  "env": {
    "GOTOOLCHAIN": "local",
    "DUVET_VERSION": "0.4.3",
    "DAGGER_VERSION": "0.21.9"
  },
  "shell": {
    "init_hook": [
      "export GOPATH=\"$DEVBOX_PROJECT_ROOT/.gopath\"",
      "export GOBIN=\"$GOPATH/bin\"",
      "export CARGO_HOME=\"${BATTERY_OPERATOR_CARGO_HOME:-${XDG_CACHE_HOME:-$HOME/.cache}/battery-operator/cargo}\"",
      "export PATH=\"$DEVBOX_PROJECT_ROOT/.devbox/bin:$GOBIN:$CARGO_HOME/bin:$PATH\"",
      "if [ \"$(cat \"$CARGO_HOME/.duvet-version\" 2>/dev/null)\" != \"$DUVET_VERSION\" ]; then echo \"building duvet $DUVET_VERSION (first run only)...\" >&2; cargo install duvet --version \"$DUVET_VERSION\" --locked --quiet && echo \"$DUVET_VERSION\" > \"$CARGO_HOME/.duvet-version\"; fi",
      "\"$DEVBOX_PROJECT_ROOT/hack/install-dagger.sh\" \"$DEVBOX_PROJECT_ROOT/.devbox/bin\""
    ],
    "scripts": {
      "build": "make build",
      "test": "make test",
      "lint": "make lint",
      "duvet": "make duvet",
      "coverage-gate": "hack/duvet-coverage.sh \"$@\""
    }
  }
}
