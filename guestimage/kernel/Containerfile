# The Guest Images' kernel (docs/requirements/13-guest-image.md): an OCI
# image with the kernel at the path a Pool's spec.template.kernel.filename
# names, boot/vmlinux. flintlockd pulls it and hands the file to
# Firecracker. The build context is guestimage/kernel.
#
# Firecracker's CI kernel, 6.1, for the image's platform: aarch64 or x86_64.
# It has virtio-vsock, virtio-blk, ext4 and devtmpfs built in, so the guest
# agent is reachable and systemd boots without an initrd. On aarch64 it is
# the uncompressed Image that Firecracker loads, whatever its name; on
# x86_64 an ELF vmlinux. It has no virtio-pci, so it does not boot on Cloud
# Hypervisor (#202). The sha256s are pinned here, computed from the
# downloads: Firecracker's bucket publishes no checksum.
#
# Every stage runs on the build machine's own platform: nothing here runs
# the kernel, so no platform is emulated. alpine:3.22 is pinned by the
# digest of its multi-platform index; resolve a new one with
# `docker buildx imagetools inspect mirror.gcr.io/library/alpine:3.22`.

ARG FIRECRACKER_CI_VERSION=v1.12
ARG KERNEL_VERSION=6.1.128

#= docs/requirements/13-guest-image.md#guest-build
#/ The Guest Images' Containerfiles SHALL pin every base image by
#/ the digest of its multi-platform index.
FROM --platform=$BUILDPLATFORM mirror.gcr.io/library/alpine:3.22@sha256:5291449c3df73caf6ed85e649dec1b9e818b39a5d8c871e97afc13e9cd5e8fa8 AS fetch
ARG TARGETARCH
ARG FIRECRACKER_CI_VERSION
ARG KERNEL_VERSION
ARG KERNEL_SHA256_ARM64=cb1291c66bca75bc11cb9c8357fcef9965bb1786dffcb42a60923c3e0e49f319
ARG KERNEL_SHA256_AMD64=27a8310b9a727517e9eb02044524b6ceb77de5728e3491b6974d5c846227ecc8
#= docs/requirements/13-guest-image.md#guest-build
#/ The Guest Images SHALL be a kernel image and a root filesystem
#/ image, each defined by one Containerfile in `guestimage/` and built for
#/ `linux/amd64` and `linux/arm64`.
#
#= docs/requirements/13-guest-image.md#guest-build
#/ The Guest Images build SHALL verify the checksum of every file
#/ it downloads against a checksum recorded in the image's Containerfile,
#/ and SHALL fail when one does not match.
#
#= docs/requirements/13-guest-image.md#guest-kernel
#/ The Guest Images' kernel image SHALL hold Firecracker's CI
#/ kernel 6.1.128 for its architecture at `boot/vmlinux`, and no other
#/ file.
#
#= docs/requirements/13-guest-image.md#guest-kernel
#/ The Guest Images' kernel image SHALL hold an x86-64 ELF
#/ `vmlinux` on `linux/amd64`, and an uncompressed arm64 `Image` on
#/ `linux/arm64`.
RUN apk add --no-cache curl && \
    case "${TARGETARCH}" in \
      arm64) uarch=aarch64; sum="${KERNEL_SHA256_ARM64}" ;; \
      amd64) uarch=x86_64; sum="${KERNEL_SHA256_AMD64}" ;; \
      *) echo "no kernel for ${TARGETARCH}" >&2; exit 1 ;; \
    esac && \
    curl -fsSL -o /vmlinux "https://s3.amazonaws.com/spec.ccfc.min/firecracker-ci/${FIRECRACKER_CI_VERSION}/${uarch}/vmlinux-${KERNEL_VERSION}" && \
    echo "${sum}  /vmlinux" | sha256sum -c - && \
    mkdir -p /out/boot && mv /vmlinux /out/boot/vmlinux && chmod 0644 /out/boot/vmlinux

# check: the kernel is where a Pool looks for it, and of the image's
# architecture. The image takes the kernel from this stage, so no builder
# can skip it.
FROM --platform=$BUILDPLATFORM mirror.gcr.io/library/alpine:3.22@sha256:5291449c3df73caf6ed85e649dec1b9e818b39a5d8c871e97afc13e9cd5e8fa8 AS check
ARG TARGETARCH
ARG KERNEL_VERSION
COPY --from=fetch /out/ /out/
COPY check.sh /check.sh
#= docs/requirements/13-guest-image.md#guest-build
#/ The Guest Images build SHALL run a check stage for each image
#/ that fails unless the image holds what this document requires of it.
RUN sh /check.sh /out "${TARGETARCH}" "${KERNEL_VERSION}"

# The image: the kernel and nothing else.
FROM scratch
ARG FIRECRACKER_CI_VERSION
ARG KERNEL_VERSION
COPY --from=check /out/boot/vmlinux /boot/vmlinux
LABEL org.opencontainers.image.title="battery-operator guest kernel" \
      org.opencontainers.image.description="Firecracker's CI kernel for battery-operator's Pools, at boot/vmlinux" \
      org.opencontainers.image.source="https://github.com/phoban01/battery-operator" \
      org.opencontainers.image.licenses="GPL-2.0-only" \
      org.opencontainers.image.version="${KERNEL_VERSION}" \
      dev.liquidmetal-x.battery.firecracker-ci="${FIRECRACKER_CI_VERSION}"
