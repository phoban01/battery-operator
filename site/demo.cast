[19.159973, "o", "kind: Pool\r\nmetadata:\r\n  name: demo\r\n  namespace: demo\r\nspec:\r\n  size: 2\r\n  template:\r\n    vcpu: 1\r\n    memoryInMb: 1024\r\n    kernel:\r\n      image: 127.0.0.1:5000/bo-trial/kernel:6.1\r\n      filename: boot/vmlinux\r\n    rootVolume:\r\n      containerSource: 127.0.0.1:5000/bo-trial/rootfs:24.04\r\n    interfaces:\r\n      - deviceId: eth1\r\n        type: Tap\r\n  placement:\r\n    nodeSelector:\r\n      battery.liquidmetal-x.dev/host: \"true\"\r\n  replenishment:\r\n    type: ImmediateOnLease\r\n  hooks:\r\n    # Runs in each new MicroVM, through its guest agent, before it is warm.\r\n    create: [\"uname -r\"]\r\n    failurePolicy: DeleteAndReplace\r\n  lease:\r\n    heartbeatInterval: 10s\r\n    expiryThreshold: 30s\r\n"]
