# devbox: project-local GOPATH and the tools built into the project
/.gopath/
/.devbox/

# kubebuilder: tools and envtest binaries in bin/, and build and test output
bin/*
*.test
*.out
go.work
!vendor/**/zz_generated.*
.idea
.vscode
*.swp
*.swo
*~
# a kubeconfig might contain secrets
*.kubeconfig

# the image tarballs of `dagger call images export --path=dist/images`
/dist/images/

# the e2e suite writes its kustomization for each run here
/test/e2e/.run/

# hack/quint-verify.sh leaves Apalache's counterexamples here
/_apalache-out/
