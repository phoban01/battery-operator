#= docs/requirements/11-host-image.md#image-networking
#/ The Host Image SHALL create a Linux bridge at boot with the
#/ guest subnet from the Host configuration file and SHALL configure
#/ `flintlockd` to attach TAP interfaces to it.
[Unit]
Description=Host Image: guest bridge virbr-battery, NAT and guest firewall
Documentation=https://github.com/phoban01/battery-operator/blob/main/hostimage/README.md
Requires=battery-host-config.service
Wants=network-online.target
After=battery-host-config.service network-online.target nftables.service systemd-modules-load.service systemd-sysctl.service
Before=flintlockd.service battery-dnsmasq.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/battery/network

[Install]
WantedBy=multi-user.target
