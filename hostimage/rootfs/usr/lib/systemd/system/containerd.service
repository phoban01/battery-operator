# containerd's upstream unit of v2.2.9, with the binary under /usr/bin
# because /usr/local is a link into /var on a bootc host, and ordered after
# the thin pool so that the devmapper snapshotter finds it. Like upstream's
# v2 unit it sets no LimitNOFILE: containers inherit containerd's limits,
# and containerd v2 recommends systemd's default. One containerd serves
# both the kubelet (namespace k8s.io, overlayfs) and flintlockd (namespace
# flintlock, devmapper). When the thin pool is missing containerd still
# starts, without the devmapper snapshotter, so the Host's Node stays
# reachable and can say why it is not ready.
#
#= docs/requirements/11-host-image.md#image-flintlockd
#/ The Host Image SHALL run `flintlockd`, its containerd and every
#/ hypervisor process they start as systemd services outside the cgroup of
#/ any Kubernetes pod.
[Unit]
Description=containerd container runtime
Documentation=https://containerd.io
After=network.target dbus.service local-fs.target battery-thin-pool.service
Wants=battery-thin-pool.service

[Service]
ExecStartPre=-/usr/sbin/modprobe overlay
ExecStart=/usr/bin/containerd --config /etc/containerd/config.toml
Type=notify
Delegate=yes
KillMode=process
Restart=always
RestartSec=5
LimitNPROC=infinity
LimitCORE=infinity
TasksMax=infinity
OOMScoreAdjust=-999

[Install]
WantedBy=multi-user.target
