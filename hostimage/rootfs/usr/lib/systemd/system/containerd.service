# containerd's upstream unit of v2.2.9, with the binary under /usr/bin
# because /usr/local is a link into /var on a bootc host, and ordered after
# the thin pool so that the devmapper snapshotter finds it. Like upstream's
# v2 unit it sets no LimitNOFILE: containers inherit containerd's limits,
# and containerd v2 recommends systemd's default. One containerd serves
# both the kubelet (namespace k8s.io, overlayfs) and flintlockd (namespace
# flintlock, devmapper). When the thin pool is missing containerd still
# starts, without the devmapper snapshotter, so the Host's Node stays
# reachable and can say why it is not ready.
#
#= docs/requirements/11-host-image.md#image-flintlockd
#/ The Host Image SHALL run `flintlockd`, its containerd and every
#/ hypervisor process they start as systemd services outside the cgroup of
#/ any Kubernetes pod.
#
#= docs/requirements/11-host-image.md#image-storage
#/ The Host Image SHALL configure containerd's devicemapper
#/ snapshotter with the MicroVM base image size that it reads from the Host
#/ configuration file, and with 10 GB when none is set.
# devmapper-config writes /run/battery/containerd.toml from
# /etc/containerd/config.toml with base_image_size from the Host
# configuration, and containerd reads that. It runs after
# battery-host-config.service, which writes the size into host.env, and
# without requiring it, so that containerd starts when the Host
# configuration is invalid.
[Unit]
Description=containerd container runtime
Documentation=https://containerd.io
After=network.target dbus.service local-fs.target battery-host-config.service battery-thin-pool.service
Wants=battery-thin-pool.service

[Service]
ExecStartPre=-/usr/sbin/modprobe overlay
ExecStartPre=/usr/libexec/battery/devmapper-config
ExecStart=/usr/bin/containerd --config /run/battery/containerd.toml
Type=notify
Delegate=yes
KillMode=process
Restart=always
RestartSec=5
LimitNPROC=infinity
LimitCORE=infinity
TasksMax=infinity
OOMScoreAdjust=-999

[Install]
WantedBy=multi-user.target
