#= docs/requirements/11-host-image.md#image-storage
#/ The Host Image SHALL create the containerd devicemapper thin
#/ pool at boot on the block device named in the Host configuration file, or,
#/ when none is named, on the unused instance-store device it detects.
# Before=containerd.service so that containerd finds its pool when it loads
# the devmapper snapshotter. flintlockd.service Requires= this unit; the
# reason for a failure is in /run/battery/not-ready.d/battery-thin-pool.
[Unit]
Description=Host Image: containerd thin pool
Documentation=https://github.com/phoban01/battery-operator/blob/main/hostimage/README.md
Requires=battery-host-config.service
After=battery-host-config.service systemd-modules-load.service lvm2-monitor.service
Before=containerd.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/battery/thin-pool
TimeoutStartSec=5min

[Install]
WantedBy=multi-user.target
