#!/usr/bin/bash
# battery-kvm.service: decide on the Host, at boot, whether it can run MicroVMs.
# The Exec Agent checks the device too (EA-031); this gate is what keeps
# flintlockd from starting without it.
BATTERY_UNIT=battery-kvm
# shellcheck source=hostimage/rootfs/usr/libexec/battery/lib.sh
. "${BATTERY_LIB:-/usr/libexec/battery/lib.sh}"

BATTERY_KVM_DEVICE=${BATTERY_KVM_DEVICE:-/dev/kvm}

# flintlockd runs as root and hands /dev/kvm to every MicroVM, so the device
# has to be a character device that root can open for reading and writing;
# the open fails when the node exists but no KVM driver is behind it, which
# is what a virtualized instance without nested virtualization looks like.
kvm_status() {
  if [ ! -e "$BATTERY_KVM_DEVICE" ]; then
    echo "$BATTERY_KVM_DEVICE does not exist"
  elif [ ! -c "$BATTERY_KVM_DEVICE" ]; then
    echo "$BATTERY_KVM_DEVICE is not a character device"
  elif ! { : <>"$BATTERY_KVM_DEVICE"; } 2>/dev/null; then
    echo "$BATTERY_KVM_DEVICE cannot be opened for reading and writing"
  else
    echo ok
  fi
}

# kvm.ko alone creates no device; the vendor module does. Both are tried
# here as well as in modules-load.d because only one of them can load.
modprobe -q kvm_intel 2>/dev/null || modprobe -q kvm_amd 2>/dev/null || true

#= docs/requirements/11-host-image.md#kernel-and-kvm
#/ If `/dev/kvm` is absent or unusable at boot, then the Host Image
#/ SHALL NOT start `flintlockd` and SHALL report the Host as not ready with
#/ the reason that KVM is unavailable.
status=$(kvm_status)
if [ "$status" != ok ]; then
  refuse "KVM is unavailable: $status"
fi
ready
log "$BATTERY_KVM_DEVICE is usable"
