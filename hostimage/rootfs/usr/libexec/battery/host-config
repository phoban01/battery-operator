#!/usr/bin/bash
# battery-host-config.service: validate the Host configuration file and publish
# the result, with the addressing derived from the guest subnet, as
# /run/battery/host.env for every other unit of the Host Image.
BATTERY_UNIT=battery-host-config
# shellcheck source=hostimage/rootfs/usr/libexec/battery/lib.sh
. "${BATTERY_LIB:-/usr/libexec/battery/lib.sh}"

#= docs/requirements/11-host-image.md#host-configuration
#/ The Host Image SHALL read per-Host settings from one Host
#/ configuration file that cloud-init writes at first boot, containing the
#/ guest subnet, the thin pool device, the protected CIDRs and the Host
#/ reserve.
KEYS="GUEST_SUBNET THIN_POOL_DEVICE PROTECTED_CIDRS HOST_RESERVE_VCPU HOST_RESERVE_MEMORY_MB HOST_CONTROL_PORTS EXEC_AGENT_UID FLINTLOCKD_CLIENT_CIDRS"
declare -A CONF=()

#= docs/requirements/11-host-image.md#host-configuration
#/ The Host Image SHALL NOT read any secret from the Host
#/ configuration file or from instance user-data.
# The file is parsed, never sourced, and only the keys above are taken from
# it: a line with any other key is skipped without its value being kept,
# logged or passed on. Nothing in the image reads instance user-data; that
# is cloud-init's business alone.
read_conf() {
  local file=$1 line key value n=0
  while IFS= read -r line || [ -n "$line" ]; do
    n=$((n + 1))
    line=${line%%#*}
    [[ $line =~ ^[[:space:]]*$ ]] && continue
    if ! [[ $line =~ ^[[:space:]]*([A-Z][A-Z0-9_]*)[[:space:]]*=[[:space:]]*(.*)$ ]]; then
      refuse "host configuration invalid: $file line $n is not KEY=value"
    fi
    key=${BASH_REMATCH[1]}
    value=${BASH_REMATCH[2]}
    value=${value%"${value##*[![:space:]]}"}
    if [[ $value =~ ^\"(.*)\"$ ]] || [[ $value =~ ^\'(.*)\'$ ]]; then
      value=${BASH_REMATCH[1]}
    fi
    case " $KEYS " in
    *" $key "*) CONF[$key]=$value ;;
    *) log "$file line $n: ignoring unknown key $key" ;;
    esac
  done <"$file"
}

[ -r "$BATTERY_HOST_DEFAULTS" ] || die "$BATTERY_HOST_DEFAULTS is missing from the image"
read_conf "$BATTERY_HOST_DEFAULTS"

#= docs/requirements/11-host-image.md#host-configuration
#/ If the Host configuration file is absent, then the Host Image
#/ SHALL boot with its defaults for every setting.
if [ -e "$BATTERY_HOST_CONF" ]; then
  read_conf "$BATTERY_HOST_CONF"
else
  log "$BATTERY_HOST_CONF is absent; using the image defaults for every setting"
fi

bad() { refuse "host configuration invalid: $*"; }
is_uint() { [[ $1 =~ ^[0-9]+$ ]]; }

#= docs/requirements/11-host-image.md#image-networking
#/ The Host Image SHALL use a default guest subnet that the Host
#/ configuration file can override, so that it can be kept clear of the
#/ cluster's node, pod and service ranges.
subnet=${CONF[GUEST_SUBNET]}
valid_cidr4 "$subnet" || bad "GUEST_SUBNET $subnet is not an IPv4 CIDR"
prefix=${subnet#*/}
[ "$prefix" -le 29 ] || bad "GUEST_SUBNET $subnet is smaller than /29"
[ "$prefix" -ge 8 ] || bad "GUEST_SUBNET $subnet is larger than /8"

device=${CONF[THIN_POOL_DEVICE]}
if [ -n "$device" ] && ! [[ $device =~ ^/dev/[A-Za-z0-9._/-]+$ ]]; then
  bad "THIN_POOL_DEVICE $device is not a /dev path"
fi

cidrs=${CONF[PROTECTED_CIDRS]// /}
for c in ${cidrs//,/ }; do
  valid_cidr4 "$c" || bad "PROTECTED_CIDRS entry $c is not an IPv4 CIDR"
done

is_uint "${CONF[HOST_RESERVE_VCPU]}" || bad "HOST_RESERVE_VCPU is not a whole number"
is_uint "${CONF[HOST_RESERVE_MEMORY_MB]}" || bad "HOST_RESERVE_MEMORY_MB is not a whole number"
control_ports=${CONF[HOST_CONTROL_PORTS]// /}
valid_ports "$control_ports" || bad "HOST_CONTROL_PORTS is not a comma-separated list of ports"
[ -n "$control_ports" ] || bad "HOST_CONTROL_PORTS is empty"

#= docs/requirements/11-host-image.md#image-flintlockd
#/ The Host Image SHALL refuse connections to `flintlockd`'s port
#/ from the Host's own processes unless they belong to the Exec Agent's user
#/ id, which it reads from the Host configuration file with a default when
#/ none is set.
# The one user id the firewall lets reach flintlockd from the Host itself.
# Root is refused like any other user, so 0 is not the Exec Agent's user id,
# and neither is 4294967295, which is no user at all.
agent_uid=${CONF[EXEC_AGENT_UID]}
if ! [[ $agent_uid =~ ^[0-9]{1,10}$ ]] || [ "$((10#$agent_uid))" -lt 1 ] || [ "$((10#$agent_uid))" -gt 4294967294 ]; then
  bad "EXEC_AGENT_UID is not a user id from 1 to 4294967294"
fi

#= docs/requirements/11-host-image.md#image-flintlockd
#/ The Host Image SHALL drop every connection to `flintlockd`'s
#/ port that arrives from outside the Host unless its source address is in
#/ the Operator's pod network, which it reads from the Host configuration
#/ file.
# Comma-separated IPv4 CIDRs; empty admits nothing from outside the Host.
client_cidrs=${CONF[FLINTLOCKD_CLIENT_CIDRS]// /}
for c in ${client_cidrs//,/ }; do
  valid_cidr4 "$c" || bad "FLINTLOCKD_CLIENT_CIDRS entry $c is not an IPv4 CIDR"
done
if [[ $client_cidrs =~ (^,|,,|,$) ]]; then bad "FLINTLOCKD_CLIENT_CIDRS has an empty entry"; fi

# The addressing: the gateway is the first address, DHCP hands out the
# rest, leaving the first ten of a subnet larger than /26 for static use.
mask=$(((0xffffffff << (32 - prefix)) & 0xffffffff))
base=$(($(ip4_to_int "${subnet%/*}") & mask))
size=$((1 << (32 - prefix)))
gateway=$(int_to_ip4 $((base + 1)))
dhcp_start=$((base + 2))
[ "$size" -gt 64 ] && dhcp_start=$((base + 10))

mkdir -p "$BATTERY_RUN"
tmp=$(mktemp "$BATTERY_RUN/.host.env.XXXXXX")
cat >"$tmp" <<EOF
# Written by battery-host-config.service at every boot. Do not edit.
BATTERY_GUEST_SUBNET=$(int_to_ip4 "$base")/$prefix
BATTERY_PREFIX=$prefix
BATTERY_NETMASK=$(int_to_ip4 "$mask")
BATTERY_GATEWAY=$gateway
BATTERY_DHCP_START=$(int_to_ip4 "$dhcp_start")
BATTERY_DHCP_END=$(int_to_ip4 $((base + size - 2)))
BATTERY_THIN_POOL_DEVICE=$device
BATTERY_PROTECTED_CIDRS=$cidrs
BATTERY_HOST_RESERVE_VCPU=$((10#${CONF[HOST_RESERVE_VCPU]}))
BATTERY_HOST_RESERVE_MEMORY_MB=$((10#${CONF[HOST_RESERVE_MEMORY_MB]}))
BATTERY_HOST_CONTROL_PORTS=$control_ports
BATTERY_EXEC_AGENT_UID=$((10#$agent_uid))
BATTERY_FLINTLOCKD_CLIENT_CIDRS=$client_cidrs
EOF
chmod 0644 "$tmp"
#= docs/requirements/11-host-image.md#kernel-and-kvm
#/ The Host Image SHALL label the Host environment file and the not ready
#/ reason directory it writes under `/run/battery` so that the containers of
#/ pods on the Host can read them, under the base image's SELinux policy and
#/ without changing the domain of any container or the label of any other
#/ path.
# A DaemonSet on the Host may read this file for the Host's settings, such
# as the bridge gateway. A rename keeps the label of the file renamed, and
# mktemp's file in /run/battery would be battery_run_t, so the file gets the
# Host environment file's label (selinux/battery.fc names the temporary
# names too) before it takes its place: there is never a host.env a
# container cannot read.
relabel "$tmp" || refuse "cannot label $BATTERY_HOST_ENV for containers"
mv -f "$tmp" "$BATTERY_HOST_ENV"
ready
log "guest subnet $(int_to_ip4 "$base")/$prefix, gateway $gateway, thin pool device ${device:-auto-detect}"
