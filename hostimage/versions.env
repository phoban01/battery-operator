# The one versions file of the Host Image. The Containerfile reads it at
# build time, check.sh reads it inside the built image, the Dagger module
# reads it for the build arguments, and a copy is installed at
# /usr/share/battery/versions.env.
#
# Format: KEY=value, one per line, no quoting, no spaces, no shell. The file
# is sourced by bash and parsed line by line, so keep it that simple.
#
# The image is built for amd64 (x86_64) and arm64 (aarch64), HI-002. Every
# download has one checksum per architecture: *_SHA256_AMD64 is the sha256
# of the amd64 artifact named next to it, and *_SHA256_ARM64 that of the
# arm64 one. Bumping a version without bumping both checksums fails the
# build (HI-004); an empty checksum fails the build too. Never paste a
# checksum that was not computed from, or published beside, the artifact
# itself.

#= docs/requirements/11-host-image.md#image-build
#/ The Host Image SHALL contain containerd, Firecracker with its
#/ jailer, Cloud Hypervisor, `flintlockd`, the kubelet, `kubeadm` and
#/ cloud-init at the versions pinned in one versions file that the
#/ Containerfile reads.

# containerd, from the upstream release tarball so that the devmapper
# snapshotter is certainly built in. The checksums are those of the
# release's .sha256sum files.
# https://github.com/containerd/containerd/releases/download/v1.7.22/containerd-1.7.22-linux-amd64.tar.gz
# https://github.com/containerd/containerd/releases/download/v1.7.22/containerd-1.7.22-linux-arm64.tar.gz
CONTAINERD_VERSION=v1.7.22
CONTAINERD_SHA256_AMD64=f8b2d935d1f86003f4e0c1af3b9f0d2820bacabe6dc9f562785b74af24c5e468
CONTAINERD_SHA256_ARM64=48d0a8461ae829b12b07c3663b14b70287d0607a0792719c51b4e4dd700b02ce

# runc, which containerd needs for the pods of the Host's own Node (the Exec
# Agent); flintlockd itself never runs a container. The checksums are those
# of the release's runc.sha256sum.
# https://github.com/opencontainers/runc/releases/download/v1.3.6/runc.amd64
# https://github.com/opencontainers/runc/releases/download/v1.3.6/runc.arm64
RUNC_VERSION=v1.3.6
RUNC_SHA256_AMD64=3f3921dbbee7723e9868f97e88e51ffc910206e3ba55646e74d93d24ea76023c
RUNC_SHA256_ARM64=6be27a061ef89bb14c6cb495405bba80f46cea213b8f79378a6086b1bac6b747

# Firecracker and its jailer, from one release tarball per architecture.
# The checksums are those of the release's .sha256.txt files.
# https://github.com/firecracker-microvm/firecracker/releases/download/v1.10.1/firecracker-v1.10.1-x86_64.tgz
# https://github.com/firecracker-microvm/firecracker/releases/download/v1.10.1/firecracker-v1.10.1-aarch64.tgz
FIRECRACKER_VERSION=v1.10.1
FIRECRACKER_SHA256_AMD64=36112969952b0e34fadcfca769d48a55dc22cbba99af17e02bd0e24fc35adc77
FIRECRACKER_SHA256_ARM64=9e3641071de140979afaac0c52fdc107baeba398bdb5709c12f77ee469207fcd

# Cloud Hypervisor, the static binary. Upstream publishes no checksum file
# for this release; the values were computed from the downloaded assets.
# https://github.com/cloud-hypervisor/cloud-hypervisor/releases/download/v41.0/cloud-hypervisor-static
# https://github.com/cloud-hypervisor/cloud-hypervisor/releases/download/v41.0/cloud-hypervisor-static-aarch64
CLOUD_HYPERVISOR_VERSION=v41.0
CLOUD_HYPERVISOR_SHA256_AMD64=a31ae726db84f24fb9a846716e893e9111bf7a46f133d1307487a38842740088
CLOUD_HYPERVISOR_SHA256_ARM64=ecfdac6725239a34575ab42ca1ff009fbea614edef97d11dea9d40c0860ef37a

# flintlockd. battery v0.3.3 refuses to provision on a flintlockd older than
# v0.15.2 (docs/requirements/10-battery.md). The checksums are those of the
# release's checksums.txt.
# https://github.com/liquidmetal-dev/flintlock/releases/download/v0.15.2/flintlockd_amd64
# https://github.com/liquidmetal-dev/flintlock/releases/download/v0.15.2/flintlockd_arm64
FLINTLOCK_VERSION=v0.15.2
FLINTLOCK_SHA256_AMD64=d08a4bd8eef185d948dd35d2857c0a3bb8db35195f88d2aa437e1e8667b0a1a8
FLINTLOCK_SHA256_ARM64=67cee5887e77f1b048ec040b4ac6e14474d4574437be7ad9fc9512a4c40a17f4

# The kubelet and kubeadm come as RPMs from pkgs.k8s.io at exactly this
# version, for the image's architecture. The packages are verified by dnf
# against the repository signing key, and the key itself is the download
# this checksum pins. It is one file for every architecture.
# v1.35 is the last minor that supports containerd 1.x.
# https://pkgs.k8s.io/core:/stable:/v1.35/rpm/repodata/repomd.xml.key
KUBERNETES_VERSION=v1.35.8
KUBERNETES_REPO_KEY_SHA256=7627818cf7bae52f9008c93e8b1f961f53dea11d40891778de216fb1b43be54d

# cloud-init comes from the Fedora repositories of the base image, which
# verify it by signature; the build installs exactly this upstream version
# and fails when the repositories no longer carry it.
CLOUD_INIT_VERSION=26.1
