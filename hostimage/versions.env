# The one versions file of the Host Image. The Containerfile reads it at
# build time, check.sh reads it inside the built image, the Dagger module
# reads it for the build arguments, and a copy is installed at
# /usr/share/battery/versions.env.
#
# Format: KEY=value, one per line, no quoting, no spaces, no shell. The file
# is sourced by bash and parsed line by line, so keep it that simple.
#
# The image is built for amd64 (x86_64) and arm64 (aarch64), HI-002. Every
# download has one checksum per architecture: *_SHA256_AMD64 is the sha256
# of the amd64 artifact named next to it, and *_SHA256_ARM64 that of the
# arm64 one. Bumping a version without bumping both checksums fails the
# build (HI-004); an empty checksum fails the build too. Never paste a
# checksum that was not computed from, or published beside, the artifact
# itself.

#= docs/requirements/11-host-image.md#image-build
#/ The Host Image SHALL contain containerd, Firecracker with its
#/ jailer, Cloud Hypervisor, `flintlockd`, the kubelet, `kubeadm` and
#/ cloud-init at the versions pinned in one versions file that the
#/ Containerfile reads.

# containerd, from the upstream release tarball so that the devmapper
# snapshotter is certainly built in. v2.2.9 is the containerd that
# flintlock v0.16.0's hosted e2e tests run, and the version of its
# containerd client. The checksums are those of the release's .sha256sum
# files.
# https://github.com/containerd/containerd/releases/download/v2.2.9/containerd-2.2.9-linux-amd64.tar.gz
# https://github.com/containerd/containerd/releases/download/v2.2.9/containerd-2.2.9-linux-arm64.tar.gz
CONTAINERD_VERSION=v2.2.9
CONTAINERD_SHA256_AMD64=a0f8e44adcb8f6cb969938b7f81182577b3c4e1872fc9905b311aae0d944c377
CONTAINERD_SHA256_ARM64=a4ace72f4f80260f39a5ec1c30c8a1c96b0b08b6636efc6ad1a3e0bfa24889d3

# runc, which containerd needs for the pods of the Host's own Node (the Exec
# Agent); flintlockd itself never runs a container. The checksums are those
# of the release's runc.sha256sum.
# https://github.com/opencontainers/runc/releases/download/v1.3.6/runc.amd64
# https://github.com/opencontainers/runc/releases/download/v1.3.6/runc.arm64
RUNC_VERSION=v1.3.6
RUNC_SHA256_AMD64=3f3921dbbee7723e9868f97e88e51ffc910206e3ba55646e74d93d24ea76023c
RUNC_SHA256_ARM64=6be27a061ef89bb14c6cb495405bba80f46cea213b8f79378a6086b1bac6b747

# Firecracker and its jailer, from one release tarball per architecture of
# the upstream project, which is where flintlock v0.16.0's hosted e2e
# installs it from. The checksums are those of the release's .sha256.txt
# files.
# https://github.com/firecracker-microvm/firecracker/releases/download/v1.16.1/firecracker-v1.16.1-x86_64.tgz
# https://github.com/firecracker-microvm/firecracker/releases/download/v1.16.1/firecracker-v1.16.1-aarch64.tgz
FIRECRACKER_VERSION=v1.16.1
FIRECRACKER_SHA256_AMD64=382a02a869e4d6d5cb14c40577f9545e8458021ea8b0b2d3fc10ec14d9c242e6
FIRECRACKER_SHA256_ARM64=8d0e69f6d6f9a1724551f607f18504052c16c1828ee3d4d7b6e6c73380871e0e

# Cloud Hypervisor, the static binary. v48.0 is the version flintlock
# v0.16.0's hosted e2e tests. Upstream publishes no checksum file for this
# release; the values were computed from the downloaded assets.
# https://github.com/cloud-hypervisor/cloud-hypervisor/releases/download/v48.0/cloud-hypervisor-static
# https://github.com/cloud-hypervisor/cloud-hypervisor/releases/download/v48.0/cloud-hypervisor-static-aarch64
CLOUD_HYPERVISOR_VERSION=v48.0
CLOUD_HYPERVISOR_SHA256_AMD64=e967dd736d434052f15883c5ef044b0d0ff36360d3df7082797fa7553be75092
CLOUD_HYPERVISOR_SHA256_ARM64=a485f707a403463bcb39d6e2620639966887e4707a31f0c514d508d6fcaf7b70

# flintlockd. battery v0.3.3 refuses to provision on a flintlockd older than
# v0.15.2 (docs/requirements/10-battery.md). The checksums are those of the
# release's checksums.txt.
# https://github.com/liquidmetal-dev/flintlock/releases/download/v0.16.0/flintlockd_amd64
# https://github.com/liquidmetal-dev/flintlock/releases/download/v0.16.0/flintlockd_arm64
FLINTLOCK_VERSION=v0.16.0
FLINTLOCK_SHA256_AMD64=aca5db57bfd941db7b1b2c046b60f1793ff98a02a67242d7f727c84c3add0773
FLINTLOCK_SHA256_ARM64=5c181177f1e136ec3a7c948404d4a2cffb01a1d63fb7cde5d8f3a4648c0c9bd0

# The kubelet and kubeadm come as RPMs from pkgs.k8s.io at exactly this
# version, for the image's architecture. The packages are verified by dnf
# against the repository signing key, and the key itself is the download
# this checksum pins. It is one file for every architecture.
# v1.35 was held because it is the last minor that supports containerd 1.x.
# containerd v2 lifts that; a later minor is a change of its own.
# https://pkgs.k8s.io/core:/stable:/v1.35/rpm/repodata/repomd.xml.key
KUBERNETES_VERSION=v1.35.8
KUBERNETES_REPO_KEY_SHA256=7627818cf7bae52f9008c93e8b1f961f53dea11d40891778de216fb1b43be54d

# cloud-init comes from the Fedora repositories of the base image, which
# verify it by signature; the build installs exactly this upstream version
# and fails when the repositories no longer carry it.
CLOUD_INIT_VERSION=26.1
