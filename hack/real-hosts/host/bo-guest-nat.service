# Routes the MicroVMs on virbr-battery out through the Host (guest-nat.sh): IP
# forwarding, and NAT from 10.220.0.0/24. iptables rules do not survive a
# reboot, so the script adds them again at every boot.
[Unit]
Description=IP forwarding and NAT for the MicroVMs on virbr-battery
After=network.target bo-bridge.service
Requires=bo-bridge.service
Before=flintlockd.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/libexec/bo-trial/guest-nat

[Install]
WantedBy=multi-user.target
